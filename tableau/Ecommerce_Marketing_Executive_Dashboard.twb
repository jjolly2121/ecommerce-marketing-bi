            <column datatype="real" name="[revenue_usd]" role="measure" type="quantitative" caption="Revenue (USD)" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)"/>
            <column-instance column="[revenue_usd]" derivation="Sum" name="[sum:revenue_usd:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <sort class="computed" column="[federated.portfolio_user_type].[none:user_type:nk]" direction="DESC" using="[federated.portfolio_user_type].[sum:revenue_usd:qk]"/>
          <aggregation value="true"/>
        </view>
        <style>
