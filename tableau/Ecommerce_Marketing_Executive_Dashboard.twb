      <aliases enabled="yes"/>
      <column datatype="date" name="[min_session_date]" role="dimension" type="quantitative" caption="Min Session Date"/>
      <column datatype="date" name="[max_session_date]" role="dimension" type="quantitative" caption="Max Session Date"/>
      <column datatype="integer" name="[sessions]" role="measure" type="quantitative" caption="Sessions"/>
      <column datatype="integer" name="[users]" role="measure" type="quantitative" caption="Users"/>
      <column datatype="integer" name="[purchase_sessions]" role="measure" type="quantitative" caption="Purchase Sessions"/>
      <column datatype="integer" name="[governed_orders]" role="measure" type="quantitative" caption="Governed Orders"/>
      <column datatype="real" name="[revenue_usd]" role="measure" type="quantitative" caption="Revenue (USD)" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)"/>
      <column caption="Session Conversion Rate" datatype="real" default-format="p0.00%" name="[Calculation_SessionConversion]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([purchase_sessions]) / SUM([sessions])"/>
      </column>
      <column caption="Average Order Value" datatype="real" default-format="c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)" name="[Calculation_AOV]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([revenue_usd]) / SUM([governed_orders])"/>
      </column>
      <column caption="Executive Recommendations" datatype="string" name="[Calculation_ExecutiveNote]" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;1  Validate and test product-view-to-cart friction.   2  Run a measured second-purchase lifecycle test.   3  Repair late-January purchase-value tracking before revenue or channel decisions.   Revenue completeness warning: 218 of 321 orders in the week of Jan 25 record $0 revenue.&quot;"/>
      </column>
      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.5" show-structure="true"/>
    </datasource>
